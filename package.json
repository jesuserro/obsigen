{
	"name": "obsigen",
	"version": "0.1.0",
	"description": "Personal Obsidian plugin for calendar, Bible and historical timeline note navigation.",
	"main": "main.js",
	"scripts": {
		"dev": "concurrently \"npm run dev:js\" \"npm run dev:css\"",
		"dev:js": "node esbuild.config.mjs",
		"dev:css": "sass --watch --no-source-map --style compressed src/styles.scss:styles.css",
		"build": "npm run typecheck && npm run build:css && node esbuild.config.mjs production",
		"build:css": "sass --no-source-map --style compressed src/styles.scss:styles.css",
		"pretypecheck": "npm run iconos",
		"typecheck": "tsc --noEmit",
		"deploy:local": "node scripts/deploy-local.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"iconos": "node src/createPrivateIcons.mjs"
	},
	"keywords": [],
	"author": "Jesús Erro",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.2",
		"@types/node": "^22.15.17",
		"@types/react": "^18.2.21",
		"@types/react-dom": "^18.2.5",
		"@types/react-icons": "^3.0.0",
		"@types/react-vertical-timeline-component": "^3.3.6",
		"@types/turndown": "^5.0.4",
		"concurrently": "^8.2.1",
		"dotenv": "^16.6.1",
		"esbuild": "0.25.5",
		"jest": "^29.5.0",
		"obsidian": "latest",
		"sass": "^1.67.0",
		"ts-jest": "^29.1.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-flagkit": "^2.0.4",
		"react-icons": "^4.11.0",
		"react-vertical-timeline-component": "^3.5.3",
		"turndown": "^7.2.0"
	}
}
